{
  "expo": {
    "name": "spike",
    "slug": "spike",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.helmmxfarma.spike",
      "appleTeamId": "Z2G8RSF85P",
      "infoPlist": {
        "NSCameraUsageDescription": "La cámara se usa para la escena de realidad aumentada.",
        "NSPhotoLibraryAddUsageDescription": "Guardar capturas del spike.",
        "CADisableMinimumFrameDurationOnPhone": true,
        "MWDAT": {
          "AppLinkURLScheme": "arspike://",
          "MetaAppID": "",
          "ClientToken": "",
          "TeamID": "$(DEVELOPMENT_TEAM)"
        },
        "NSBluetoothAlwaysUsageDescription": "Necesario para conectar con las gafas Meta.",
        "NSBluetoothPeripheralUsageDescription": "Necesario para conectar con las gafas Meta.",
        "NSLocalNetworkUsageDescription": "Conecta con las gafas por Wi-Fi y con el servidor de desarrollo.",
        "NSBonjourServices": [
          "_expo._tcp",
          "_bonjour._tcp"
        ],
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral"
        ]
      },
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true,
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-dev-client",
      [
        "@reactvision/react-viro",
        {
          "provider": "none",
          "telemetry": false,
          "ios": {
            "cameraUsagePermission": "La cámara se usa para la escena de realidad aumentada."
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.2"
          }
        }
      ]
    ],
    "scheme": "arspike"
  }
}
